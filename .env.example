# 复制本文件为 .env 后再填写真实值；.env 不得提交到版本库（规约 NFR-01）
#
# 会话签名密钥（必填）。缺失或空白时应用启动即失败，禁止使用不安全默认值。
# 生成方式示例： python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 以下为可选项，保持默认即可
# DATABASE_PATH=/app/data/app.db
# UPLOAD_DIR=/app/uploads
# MAX_UPLOAD_BYTES=5242880

# ---------------------------------------------------------------------------
# 嵌入与对话网关（课程网关，OpenAI 兼容）
#
# 纪律（spec §4）：**密钥只在服务端**。任何响应体、页面、日志都不得出现这些值。
# 缺失时应用**仍可启动**：`keyword` 模式照常工作，`vector`/`hybrid` 返回 503
# embedding_unavailable，`/api/ask` 返回 503；不会退回「凭模型记忆作答」。
# ---------------------------------------------------------------------------

# 嵌入接口基址，实际调用 POST {EMBEDDING_BASE_URL}/embeddings
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# MUST 与网关实际返回的向量维度一致；不一致按失败处理，且不写入向量
EMBEDDING_DIM=1024
# EMBEDDING_TIMEOUT=15

# 对话接口基址，实际调用 POST {CHAT_BASE_URL}/chat/completions
# 留空则复用 EMBEDDING_BASE_URL / EMBEDDING_API_KEY
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=
# CHAT_TIMEOUT=30

# ---------------------------------------------------------------------------
# 向量库（Qdrant）
#
# 缺失或不可达时：`keyword` 仍返回正文，`vector`/`hybrid` 返回 503
# vector_store_unavailable；**不编造相似度分数**。
# ---------------------------------------------------------------------------

QDRANT_URL=
# 集合名默认 campusclaw_chunks（Cosine，size = EMBEDDING_DIM）
QDRANT_COLLECTION=campusclaw_chunks
# 自建 Qdrant 未开鉴权时可留空
QDRANT_API_KEY=
# QDRANT_TIMEOUT=10
